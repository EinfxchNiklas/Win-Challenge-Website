# Gemeinsames Passwort für den Website-Zugang
APP_PASSWORD=change-me

# Langer, zufälliger String zum Signieren der Login-Session (z.B. mit: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=change-me-too

# Lokal: leer lassen -> nutzt automatisch eine lokale SQLite-Datei
# Cloud (Neon): die "Connection string" aus dem Neon-Dashboard einfügen
DATABASE_URL=

# Auf "true" setzen, sobald die Seite über HTTPS läuft (z.B. auf Render).
# Lokal (http://localhost) auf "false" lassen, sonst wird das Login-Cookie
# vom Browser verworfen.
COOKIE_SECURE=false
